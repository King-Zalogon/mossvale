      "lines": [
        {
          "when": {
            "flag": "meadow.seal"
          },
          "text": "The Meadow seal is awake, I hear. Rest here whenever you like. The hall keeps the lamp lit and the beds free."
        },
        {
          "text": "Welcome to Brackenwake Commons. Rest costs nothing here, and the shelf holds what a day on the trail needs."
        }
      ]
    },
    {
      "id": "survey-board",
      "kind": "sign",
      "sprite": "signpost-wood",
      "at": [31.4, 11.2],
