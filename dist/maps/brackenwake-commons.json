      "w": 36,
      "label": "Survey bridge plaque",
      "mapLabel": "Survey bridge",
      "lines": [
        {
          "text": "SURVEY BRIDGE. Laid for the first land survey and kept in repair by the commons ever since. South: the habitat garden."
        }
      ]
    },
    {
      "id": "lookout",
