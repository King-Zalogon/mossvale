      "lines": [
        {
          "when": {
            "visited": "amber-ridge"
          },
          "text": "From the lookout you can pick out the red spires of the far shore: the ridge you have walked. The survey line ends here."
        },
        {
          "text": "The survey line ends at this lookout. Past the water, red spires stand on a far shore, much further than they look."
        }
      ]
    },
